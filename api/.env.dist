NODE_ENV=develop
SERVER_PORT=3000
LOGGER_INFO_PATH='./info.log'
LOGGER_INFO_LEVEL='info'
LOGGER_FILE_MAX_SIZE=1000000
LOGGER_MAX_FILES=50
LOGGER_ERROR_PATH='./error.log'
LOGGER_ERROR_LEVEL='error'
POSTGRESQL_DB=jiku
POSTGRESQL_USER=localuser
POSTGRESQL_PASSWORD=localpass
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_POOL_MAX=5
POSTGRESQL_POOL_MIN=0
POSTGRESQL_POOL_IDLE=10000
# Instancia de Zitadel contra la que se validan los tokens. OBLIGATORIA: sin esto la api
# no arranca, salvo que declares AUTH_BYPASS=true (ver abajo).
IDENTITY_URL=https://id.example.com
KEY_SYNC_ATTEMPS=3

# ============================================
# Bypass de autenticación — SOLO desarrollo local
# ============================================
# Con AUTH_BYPASS=true la api NO valida tokens: trata cada request como un admin.
# Es opt-in explícito y está prohibido con NODE_ENV=production (el arranque falla).
# Requiere DEV_USER_ID: el id del usuario que se carga en cada request.
AUTH_BYPASS=false
DEV_USER_ID=

# ============================================
# Almacenamiento de adjuntos (compatible con S3)
# ============================================
# Sirve cualquier proveedor con API de S3: AWS S3, MinIO, DigitalOcean Spaces,
# Cloudflare R2. Para MinIO local, STORAGE_S3_FORCEPATHSTYLE tiene que ser true.
STORAGE_S3_REGION=
STORAGE_S3_CREDENTIALS_ACCESSKEY=
STORAGE_S3_CREDENTIALS_SECRETKEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKETNAME=
STORAGE_S3_FORCEPATHSTYLE=false
# Prefijo de las claves dentro del bucket. NO cambiarlo en una instalación con datos:
# la clave se guarda en attachments.storage_key y los adjuntos ya subidos quedarían
# inaccesibles.
STORAGE_S3_KEY_PREFIX=jiku

# ============================================
# Links compartidos de documentación (REQ-016 / S-080)
# ============================================
# URL pública de los links compartidos: {JIKU_PUBLIC_URL}/p/docs/{token}. Solo el origen (sin path,
# query ni fragmento) o la api no arranca. La api sirve /p/docs/* SOLO en este host y, en este host,
# nada más (DD-10). Vacía: los links quedan apagados (features.sharing=false y /p/docs/* da 404).
# Debe coincidir con la JIKU_PUBLIC_URL de jiku-docs. Local: http://127.0.0.1:3100
JIKU_PUBLIC_URL=
# Saltos de proxy de confianza para el rate limit de /p/docs/* (60/min/IP). Vacía detrás de un proxy:
# todas las IP son la del proxy y un visitante agota el cupo de todos. Vacía SIN proxy: correcto
# (un cliente podría falsear X-Forwarded-For y esquivar el límite). Producción (ingress): 1
API_TRUST_PROXY=
