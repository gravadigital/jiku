NODE_ENV=testing
SERVER_PORT=3000
LOGGER_INFO_PATH=/var/log/service_info.log
LOGGER_INFO_LEVEL=info
LOGGER_FILE_MAX_SIZE=1000000
LOGGER_MAX_FILES=50
LOGGER_ERROR_PATH=/var/log/service_error.log
LOGGER_ERROR_LEVEL=error
POSTGRESQL_DB=gestionTest
POSTGRESQL_USER=test
POSTGRESQL_PASSWORD=testing
POSTGRESQL_HOST=database
POSTGRESQL_PORT=5432
POSTGRESQL_POOL_MAX=5
POSTGRESQL_POOL_MIN=0
POSTGRESQL_POOL_IDLE=10000
IDENTITY_URL=http://localhost:4001
KEY_SYNC_ATTEMPS=3

# -- Testing vars
IDENTITY_ISSUER=issuerfake
IDENTITY_CLIENT_ID=clientidfake

# -- Storage (valores falsos para tests)
# Desde S-004 la `api` NO usa estas variables: `StorageService` ya no existe. Siguen acá porque
# el FakeBus ejecuta `core` de verdad contra la misma base (ADR-013), y el firmador de core las
# necesita para construir su cliente de S3. La firma es LOCAL —no hay red—, así que valores
# falsos alcanzan.
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_CREDENTIALS_ACCESSKEY=test-access-key
STORAGE_S3_CREDENTIALS_SECRETKEY=test-secret-key
STORAGE_S3_BUCKETNAME=test-bucket
STORAGE_S3_REGION=us-east-1

# -- Core (REQ-015/S-071): la api NO lee esta variable.
# El FakeBus ejecuta `core` de verdad contra la misma base (ADR-013), y `loadConfig()` de core
# —que este doble invoca antes de construir el Dispatcher— la exige sin default. Sin ella el
# `catch` del FakeBus deja `dispatcher = null` EN SILENCIO y todo comando devuelve
# `{status:'success'}` sin `data`, así que las rutas de escritura se quedan esperando una
# respuesta que nunca trae el id. Mismo valor sintético que `core/.env.test`.
OPUS_URL=https://opus.ejemplo.com
