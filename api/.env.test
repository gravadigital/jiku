NODE_ENV=testing
SERVER_PORT=3000
LOGGER_INFO_PATH=/var/log/service_info.log
LOGGER_INFO_LEVEL=info
LOGGER_FILE_MAX_SIZE=1000000
LOGGER_MAX_FILES=50
LOGGER_ERROR_PATH=/var/log/service_error.log
LOGGER_ERROR_LEVEL=error
POSTGRESQL_DB=gestionTest
POSTGRESQL_USER=test
POSTGRESQL_PASSWORD=testing
POSTGRESQL_HOST=database
POSTGRESQL_PORT=5432
POSTGRESQL_POOL_MAX=5
POSTGRESQL_POOL_MIN=0
POSTGRESQL_POOL_IDLE=10000
IDENTITY_URL=http://localhost:4001
KEY_SYNC_ATTEMPS=3

# -- Testing vars
IDENTITY_ISSUER=issuerfake
IDENTITY_CLIENT_ID=clientidfake

# -- Storage (fake values for testing; StorageService is mocked in tests)
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_CREDENTIALS_ACCESSKEY=test-access-key
STORAGE_S3_CREDENTIALS_SECRETKEY=test-secret-key
STORAGE_S3_BUCKETNAME=test-bucket
STORAGE_S3_REGION=us-east-1

