{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "lib": ["es2022"],

    // Sequelize-typescript define los modelos con decoradores.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
