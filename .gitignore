# dependencias
node_modules/
.pnp
.pnp.js

# builds
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# tests
coverage/

# entorno — nunca versionar valores reales.
#
# El patrón es deliberadamente amplio: un `.env_old` con secretos reales llegó a
# versionarse porque las reglas solo cubrían `.env` y `.env*.local`. Cualquier variante
# —copia, backup, respaldo con fecha— queda fuera por defecto.
.env
.env.*
.env_*
!.env.dist
!.env.defaults
!.env.test
*.env.bak
# Nota: `.env.localstack` de web y opus-web SÍ se versiona (sin secretos: son
# variables públicas que se embeben en el bundle). Los necesita `deploy/local.sh`,
# que es el camino recomendado para levantar el stack.
.env.dev
.env.prod
deploy/.env

# credenciales e identidad de NATS: se generan a mano y se colocan en el
# servidor. Ver deploy/nats/creds/README.md
# Se ignora todo el contenido de creds/ salvo el README.
deploy/nats/creds/*
!deploy/nats/creds/README.md

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# herramientas locales — no son del producto
.vscode/
*.bkp
__pycache__/
*.pyc

# copia local de material que no forma parte del producto (runbooks internos,
# notas de trabajo). No se versiona.
.archivo-publicacion/

# misc
.DS_Store
.vercel

# material sensible, por extensión y en cualquier ubicación.
# Va por extensión a propósito: una regla por carpeta se rompe en cuanto alguien
# guarda un dump o una key fuera del lugar previsto.
*.pem
*.key
*.p12
*.pfx
*.jks
*.seed
*.creds
*.sql
*-su.json

# datos y credenciales de trabajo local (dumps, keys de service user).
# Anclado con barras: `local` a secas también ignoraba cualquier archivo o
# directorio llamado `local` en todo el árbol (p.ej. src/features/local/).
/local/
# Registro interno del trabajo de publicacion. No va al repo publico.
docs/publicacion/
