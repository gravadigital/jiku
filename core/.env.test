NODE_ENV=testing

# En local, tests/setup-env.ts sobreescribe host y puerto con el contenedor efímero.
# Estos valores son los que usa CI, donde la base la provee el pipeline.
POSTGRESQL_DB=gestionTest
POSTGRESQL_USER=test
POSTGRESQL_PASSWORD=testing
POSTGRESQL_HOST=database
POSTGRESQL_PORT=5432
POSTGRESQL_POOL_MAX=5
POSTGRESQL_POOL_MIN=0
POSTGRESQL_POOL_IDLE=10000

# Conexión de SOLO LECTURA de las consultas (src/models/read.ts). El ROL lo crea
# tests/global-setup.ts después del sync: los GRANT necesitan que las tablas existan.
# NO puede ser el usuario dueño (`test`): si lo fuera, CA-5 pasaría sin probar nada, porque
# la garantía que se está verificando es un PERMISO de Postgres, no una validación de código.
POSTGRESQL_READ_USER=jiku_test_readonly
POSTGRESQL_READ_PASSWORD=readonly
POSTGRESQL_READ_POOL_MAX=10
# Holgado a propósito: los tests que necesitan un corte chico recargan el módulo con otro valor.
POSTGRESQL_STATEMENT_TIMEOUT_MS=8000

# Prefijo de subjects: {instance}.{session}.{svc}.{version}.{comando}
NATS_INSTANCE=dev
NATS_PROTOCOL_VERSION=v1

# Queue group de la suscripción plana al evento de autenticación ({instance}.events.auth).
# Redundante por definición —el código ya defaultea a este mismo valor— y va igual: es lo que
# permite que un test lo pise sin depender del shell de quien corre la suite, y lo que documenta
# la variable para quien lea el archivo.
NATS_EVENTS_QUEUE=jiku-events

LOGGER_INFO_LEVEL=error
LOGGER_ERROR_LEVEL=error

# El `sub` del service user de la api. Distinto del caller por defecto de dispatch() ('api')
# a propósito: los tests de la rama confiable tienen que pasarlo EXPLÍCITAMENTE, para que un
# test no caiga en la rama equivocada sin darse cuenta.
CORE_TRUSTED_PUBLISHER_ID=api-service-user-sub

# Storage S3: valores SINTÉTICOS, nunca reales. Los tests doblan el firmador, así que estos
# valores solo existen para que la construcción del cliente real no sea la que falle si algún
# test se olvida de instalar el doble.
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_CREDENTIALS_ACCESSKEY=test-access-key
STORAGE_S3_CREDENTIALS_SECRETKEY=test-secret-key
STORAGE_S3_BUCKETNAME=test-bucket
STORAGE_S3_REGION=us-east-1
STORAGE_S3_FORCEPATHSTYLE=true
STORAGE_S3_KEY_PREFIX=grava-gestion
