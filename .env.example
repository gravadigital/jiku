# Local stack (docker-compose.yml, `make up`). Every value has a safe default in the compose
# file, so a clean clone runs with no .env at all: copy this file to .env only to change one.
# .env is git-ignored. Servers use deploy/.env (from deploy/.env.dist), not this file.
#
# Nothing here is a real secret: identity, storage and SMTP are local stand-ins
# (deploy/test/fake-idp, MinIO, Mailpit).

# --- Database (postgres) -------------------------------------------------------------------
DATABASE_NAME=jiku
# Owner of the database: core writes with it and the migrations run with it.
DATABASE_USER=jiku
DATABASE_PASSWORD=jiku
# Role with SELECT only: the api reads with it, and core's queries over the bus (ADR-001).
DATABASE_READONLY_USER=jiku_readonly
DATABASE_READONLY_PASSWORD=jiku_readonly
# Port published on this machine.
DATABASE_PORT=5432
# Read pool and statement timeout of core's read-only connection.
POSTGRESQL_READ_POOL_MAX=10
POSTGRESQL_STATEMENT_TIMEOUT_MS=8000
POSTGRESQL_READ_RANDOM_PAGE_COST=1.1

# --- Integration tests (postgres-test, `make test-integration`) ----------------------------
TEST_DATABASE_PORT=55433

# --- Identity (fake-idp instead of Zitadel) -----------------------------------------------
# Project and OIDC client the tokens are issued for. The test users are in
# deploy/test/fake-idp/users.json.
IDENTITY_PROJECT_ID=jiku-project
IDENTITY_CLIENT_ID=jiku-web
# `sub` of the api's machine user: core trusts the identity envelope the api sends.
CORE_TRUSTED_PUBLISHER_ID=300000000000000101
# Session secrets of the two frontends (NextAuth). Local values only.
WEB_AUTH_SECRET=local-only-web-auth-secret-change-me
OPUS_AUTH_SECRET=local-only-opus-auth-secret-change-me

# --- Bus (NATS) ---------------------------------------------------------------------------
NATS_INSTANCE=local
# Ports published on this machine (change them if another project already uses them).
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_COMMAND_SERVICE=jiku-commands
NATS_QUERY_SERVICE=jiku-queries
NATS_PROTOCOL_VERSION=v1
NATS_EVENTS_VERSION=v1
NATS_EVENTS_QUEUE=jiku-events
NATS_REQUEST_TIMEOUT_MS=5000
NATS_QUERY_TIMEOUT_MS=10000
SERVICE_VERSION=1.0.0
AUTH_CALLOUT_IMAGE=gravadigital/nats-zitadel-auth-callout
AUTH_CALLOUT_VERSION=1.1.0

# --- Storage (MinIO instead of S3) ---------------------------------------------------------
STORAGE_S3_CREDENTIALS_ACCESSKEY=jiku-local
STORAGE_S3_CREDENTIALS_SECRETKEY=jiku-local-secret
STORAGE_S3_BUCKETNAME=jiku
STORAGE_S3_REGION=us-east-1
STORAGE_S3_KEY_PREFIX=jiku-local

# --- Mail (Mailpit instead of SMTP) --------------------------------------------------------
SMTP_FROM=Jiku <jiku@jiku.test>

# --- Set by docker-compose.yml for each service (not read from here) ----------------------
# api:      POSTGRESQL_HOST/DB/USER/PASSWORD/MIGRATION_USER/MIGRATION_PASSWORD, IDENTITY_URL,
#           IDENTITY_ISSUER (required: the `iss` every token must carry), KEY_SYNC_ATTEMPS, ZITADEL_SERVICE_USER_KEY, ZITADEL_ISSUER_URL, ZITADEL_PROJECT_ID,
#           NATS_URL, NATS_CREDS, JIKU_PUBLIC_URL, LOGGER_*, *_HOURS_*_ENABLED
# core:     POSTGRESQL_HOST/DB/USER/PASSWORD, POSTGRESQL_READ_USER/READ_PASSWORD,
#           ZITADEL_SERVICE_USER_KEY, ZITADEL_ISSUER_URL, NATS_URL, NATS_CREDS, OPUS_URL,
#           STORAGE_S3_ENDPOINT, STORAGE_S3_FORCEPATHSTYLE, SMTP_HOST/PORT/USER/PASSWORD, LOGGER_*
# web:      AUTH_URL, AUTH_SECRET, AUTH_TRUST_HOST, ZITADEL_ISSUER, ZITADEL_CLIENT_ID,
#           ZITADEL_PROJECT_ID, API_URL
# opus-web: NEXTAUTH_URL, NEXTAUTH_SECRET, AUTH_TRUST_HOST, ZITADEL_ISSUER, ZITADEL_CLIENT_ID,
#           ZITADEL_PROJECT_ID, API_URL
# Every variable each service accepts, with its meaning: documentation/configuration.md.

# --- Optional, not set by docker-compose.yml (defaults shown; add them to a service to use) -
# api
# Local work only: skips token validation and enters as DEV_USER_ID with role admin.
# The api refuses to start with it under NODE_ENV=production (the images).
# AUTH_BYPASS=false
# DEV_USER_ID=
# Proxy hops to trust for the client address (1 behind the ingress). Empty: none.
# API_TRUST_PROXY=
# Identity on the bus when there is no machine-user key (tests).
# NATS_USER_ID=api
# The machine-user key as base64 JSON, instead of the ZITADEL_SERVICE_USER_KEY file path.
# ZITADEL_SERVICE_USER_KEY_B64=
# core — diagnostics
# LOG_COMMANDS=false
# QUERY_TIMING=false
# QUERY_TIMING_SQL=false
# QUERY_TIMING_LOOP_MS=30000
# web
# Shortcuts to the team's tools in the navigation: JSON [{"tool":"github","href":"https://…","label":"Código"}].
# EXTERNAL_LINKS=
# APP_NAME=Jiku
# APP_DESCRIPTION=Gestión de proyectos
# Debugging only: prints the full access token to the logs. Never enable it on a server.
# LOG_ACCESS_TOKEN=false
