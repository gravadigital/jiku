# Copiar a .env y completar. NO versionar el .env resultante.

# ============================================
# GENERAL
# ============================================
# Un .sql con el esquema, para cargar la base la primera vez.
#
# NO ES OPCIONAL en una instalación nueva: las migraciones de api/db-upgrade/ parten de
# un esquema existente —la primera modifica `objectives`, y ninguna la crea—, así que
# contra una base vacía fallan con `relation "public.objectives" does not exist`.
# Ver docs/known-limitations.md.
DUMP_FILE=
STAGE=dev
DOMAIN=
OPUS_DOMAIN=
INGRESS_NETWORK=server-nginx

# ============================================
# VERSIONES (una por servicio: permite desplegar
# core sin tocar los fronts)
# ============================================
API_VERSION=1.0.0
CORE_VERSION=1.0.0
WEB_VERSION=1.0.0
OPUS_WEB_VERSION=1.0.0
# Tag de la imagen del callout (no lo pongas en AUTH_CALLOUT_IMAGE).
AUTH_CALLOUT_VERSION=0.1.0

# ============================================
# BASE DE DATOS
# ============================================
DATABASE_NETWORK=jiku-database
DATABASE_NAME=jiku
DATABASE_USER=fakeuser
DATABASE_PASSWORD=fakepass
DATABASE_PORT=5432

# Usuario de solo lectura para la api.
# La api NO debe poder escribir: es la garantía real del split,
# no alcanza con la convención.
#
# Las migraciones son la excepción: las corre la api al arrancar y sí
# necesitan escribir, así que usan DATABASE_USER (ver
# POSTGRESQL_MIGRATION_USER en el compose).
DATABASE_READONLY_USER=jiku_readonly
DATABASE_READONLY_PASSWORD=

# ============================================
# IDENTIDAD (Zitadel)
# ============================================
IDENTITY_URL=https://<tu-instancia-zitadel>
IDENTITY_ISSUER=https://<tu-instancia-zitadel>
IDENTITY_CLIENT_ID=
IDENTITY_PROJECT_ID=

# ============================================
# NATS
# ============================================
# Instancia: primer segmento de todos los subjects (dev, prod).
# Aísla despliegues que comparten el mismo NATS.
NATS_INSTANCE=dev
NATS_URL=nats://nats:4222

# Versión del protocolo, cuarto segmento del subject.
NATS_PROTOCOL_VERSION=v1

# Nombre del servicio que atiende los comandos: {instance}.{session}.{svc}.{version}.*
NATS_SERVICE_NAME=gestion

# Cuánto espera la api la respuesta de core, en milisegundos.
NATS_REQUEST_TIMEOUT_MS=5000

# Ruta de las credenciales dentro del contenedor. El archivo se monta
# como volumen; ver deploy/nats/creds/README.md
NATS_CREDS=/run/secrets/nats.creds

# Keys de los service users, en base64. NO se completan a mano:
#
#   ./service-user-key.sh api  <ruta-a-la-key.json>
#   ./service-user-key.sh core <ruta-a-la-key.json>
#
# El script valida la key contra Zitadel y la escribe acá. Cada servicio pide su
# token con ella y lo renueva antes de que venza.
#
# Los service users necesitan estos roles en Zitadel:
#   api  -> internal-app
#   core -> core
API_SERVICE_USER_KEY_B64=
CORE_SERVICE_USER_KEY_B64=

# El `sub` del service user de la api, tal como lo ve core en el subject del comando.
#
# core lo usa para distinguir el canal de la api del de un publicador externo: si el `caller`
# coincide, el actor del comando es el que viaja en el cuerpo (la api ya autenticó a esa
# persona por JWT); si no coincide, el actor es el `caller` mismo.
#
# SIN ELLA CORE NO ARRANCA, a propósito: un valor vacío mandaría TODOS los comandos por la rama
# externa, `files.uploaded_by` quedaría con el service user de la api en vez de la persona, y
# nadie podría vincular lo que subió — con `file_not_owned` como único síntoma.
#
# El valor es el campo `userId` del JSON key del machine user de la api (el mismo archivo que
# le pasás a ./service-user-key.sh api). También está en el detalle del machine user en la
# consola de Zitadel.
CORE_TRUSTED_PUBLISHER_ID=

# ============================================
# AUTH-CALLOUT
# ============================================
# El auth-callout no vive en este monorepo: se consume como imagen publicada en
# Docker Hub. La imagen trae SOLO el callout —el servidor NATS se levanta aparte,
# como servicio propio del compose—. Su configuración sí está acá, en
# deploy/nats/auth-callout/, y se monta por path.
# IMPORTANTE: acá va el repositorio SIN el tag. El compose arma la referencia como
# ${AUTH_CALLOUT_IMAGE}:${AUTH_CALLOUT_VERSION}, así que si le agregás `:0.1.0` acá
# termina pidiendo `...:0.1.0:0.1.0`. El tag va arriba, en AUTH_CALLOUT_VERSION.
AUTH_CALLOUT_IMAGE=gravadigital/nats-zitadel-auth-callout
GESTION_IDP_MODE=zitadel
GESTION_ZITADEL_ISSUER_URL=https://<tu-instancia-zitadel>
GESTION_ZITADEL_PROJECT_ID=

# ============================================
# WEB
# ============================================
WEB_NEXTAUTH_SECRET=

# ============================================
# OPUS-WEB
# ============================================
OPUS_NEXTAUTH_SECRET=

# ============================================
# ALMACENAMIENTO DE ADJUNTOS (compatible con S3)
# ============================================
# Sirve cualquier proveedor con API de S3: AWS S3, MinIO, DigitalOcean Spaces,
# Cloudflare R2. Las cinco primeras son OBLIGATORIAS: `core` las lee al procesar el PRIMER
# comando de archivos, no al arrancar — así que un arranque exitoso NO prueba que el storage
# esté bien configurado. El síntoma de una credencial mal puesta es una subida o una descarga
# que falla, no un contenedor que no levanta.
#
# DESDE REQ-001 LAS LEE `core`, que es el único dueño del storage: firma las prefirmadas de
# PUT y de GET, así que sus credenciales necesitan permiso de lectura Y de escritura.
#
# `core` ES EL ÚNICO SERVICIO QUE LAS RECIBE. La api NO tiene acceso al bucket: no están en su
# bloque `environment` de ningún compose, así que su proceso no las ve. Es una garantía de
# INFRAESTRUCTURA, no de disciplina: sin credenciales no puede tocar un objeto que `core` no le
# firmó, ni por error ni por un endpoint nuevo que se olvide de autorizar. No se las agregues
# "por las dudas": una variable de más reabre el acceso.
#
# ADVERTENCIA sobre `STORAGE_S3_KEY_PREFIX` (default `grava-gestion`): cambiarlo en una
# instalación con datos deja INACCESIBLES todos los archivos existentes, porque las claves ya
# persistidas en `files.storage_key` siguen apuntando al prefijo viejo.
#
# Para un MinIO local:
#   STORAGE_S3_ENDPOINT=http://minio:9000
#   STORAGE_S3_FORCEPATHSTYLE=true
STORAGE_S3_ENDPOINT=
STORAGE_S3_CREDENTIALS_ACCESSKEY=
STORAGE_S3_CREDENTIALS_SECRETKEY=
STORAGE_S3_BUCKETNAME=
STORAGE_S3_REGION=
STORAGE_S3_FORCEPATHSTYLE=false
STORAGE_S3_KEY_PREFIX=grava-gestion
