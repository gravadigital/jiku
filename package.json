{
  "name": "jiku",
  "version": "1.1.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Grava Digital",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "api",
    "core",
    "web",
    "opus-web"
  ],
  "scripts": {
    "postinstall": "npm run build:packages",
    "build:packages": "npm run build --workspace @jiku/models --workspace @jiku/nats-protocol --workspace @jiku/zitadel-auth",
    "build": "npm run build:packages && npm run build --workspace @jiku/api --workspace @jiku/core",
    "test": "npm run test --workspace @jiku/nats-protocol --workspace @jiku/api --workspace @jiku/core --workspace @jiku/web --workspace @jiku/opus-web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "mocha": "11.7.5",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4"
  }
}
